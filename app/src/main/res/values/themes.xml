        <item name="colorPrimary">@color/municipality_beijing</item>
        <item name="colorOnPrimary">@color/color_text_light</item>
        <item name="android:colorBackground">@color/color_default_background</item>
        <item name="android:textColorPrimary">@color/color_text_dark</item>
    </style>

    <style name="Theme.PracticalFive" parent="Base.Theme.PracticalFive" />
</resources>
