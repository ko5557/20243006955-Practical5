<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:orientation="vertical"
    tools:context=".Municipality">

    <!-- Name of the selected municipality; its background colour changes per municipality -->
    <TextView
        android:id="@+id/municipalityNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/color_text_light"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="Beijing" />

    <!-- Image of the selected municipality -->
    <ImageView
        android:id="@+id/municipalityImageView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:contentDescription="@string/content_description_municipality_image"
        android:scaleType="centerCrop"
        tools:src="@drawable/beijing" />

    <!-- Scrollable information section so long summaries never push the button off screen -->
    <ScrollView
        android:id="@+id/infoScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/infoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp"
            tools:text="Beijing is the capital of the People's Republic of China ..." />

    </ScrollView>

    <!-- Opens the official website of the selected municipality with an implicit Intent -->
    <Button
        android:id="@+id/visitSiteButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:text="@string/visit_site"
        android:textAllCaps="false"
        android:textColor="@color/color_text_light"
        android:textSize="16sp" />

</LinearLayout>
